          "options": [
            { "value": "check", "label": "Check" },
            { "value": "x", "label": "X" },
            { "value": "q", "label": "Question mark" }
          ],
          "default": "q"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GM Comparison Table",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "label": "Supports Dopamine Pathways",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "q"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "No Crash or Withdrawal",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "q"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Supports Sustained Focus",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "x"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Multi-Mechanism Neural Support",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "q"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Tolerance Doesn't Build",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "q"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "Clinically Dosed Extracts",
            "genius_mind": "check",
            "caffeine": "x",
            "generic": "x"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "label": "16 Synergistic Ingredients",
            "genius_mind": "check",
