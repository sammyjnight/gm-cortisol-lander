<style>
  #gm-cta-{{ section.id }} .mobile-only { display: block; }
  #gm-cta-{{ section.id }} .desktop-only { display: none; }

  @media (min-width: 769px) {
    #gm-cta-{{ section.id }} .mobile-only { display: none; }
    #gm-cta-{{ section.id }} .desktop-only { display: grid; }
    #gm-cta-{{ section.id }} .gm-review-carousel { display: none; }
    #gm-cta-{{ section.id }} #gm-review-carousel-desktop-{{ section.id }} { display: block; }
    #gm-cta-{{ section.id }} div[style*="gap: 40px"] { gap: 56px; }
    #gm-cta-{{ section.id }} div[style*="gap: 40px"] img { height: 28px; }
  }
  @media (max-width: 768px) {
    #gm-cta-{{ section.id }} #gm-review-carousel-desktop-{{ section.id }} { display: none; }
  }
  @media (min-width: 769px) {
    #gm-cta-{{ section.id }} { padding: 96px 0 !important; }
  }

  /* Touch swipe styles */
  #gm-cta-{{ section.id }} .gm-review-track {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }
  #gm-cta-{{ section.id }} .gm-review-slide {
    scroll-snap-align: start;
  }
</style>

<script>
(function() {
  document.addEventListener('DOMContentLoaded', function() {
    var carousels = document.querySelectorAll('#gm-cta-{{ section.id }} .gm-review-carousel');

    carousels.forEach(function(carousel) {
      var track = carousel.querySelector('.gm-review-track');
      var slides = carousel.querySelectorAll('.gm-review-slide');
      var dots = carousel.querySelectorAll('.gm-review-dot');
      var current = 0;
      var total = slides.length;
      var startX = 0;
      var diffX = 0;

      if (total === 0) return;

      function goTo(index) {
        if (index < 0) index = total - 1;
        if (index >= total) index = 0;
        current = index;
        track.style.transform = 'translateX(-' + (current * 100) + '%)';
        track.style.transition = 'transform 0.3s ease';
        dots.forEach(function(dot, i) {
          dot.style.background = i === current ? '#00A6D2' : 'rgba(255,255,255,0.2)';
          dot.classList.toggle('active', i === current);
        });
      }

      dots.forEach(function(dot) {
        dot.addEventListener('click', function() {
          goTo(parseInt(dot.getAttribute('data-index'), 10));
        });
      });

      /* Touch / swipe */
      track.addEventListener('touchstart', function(e) {
        startX = e.touches[0].clientX;
        diffX = 0;
        track.style.transition = 'none';
      }, { passive: true });

      track.addEventListener('touchmove', function(e) {
        diffX = e.touches[0].clientX - startX;
      }, { passive: true });

      track.addEventListener('touchend', function() {
        if (Math.abs(diffX) > 40) {
          if (diffX < 0) goTo(current + 1);
          else goTo(current - 1);
        } else {
          goTo(current);
        }
      });

      /* Auto-advance every 5s */
      var autoTimer = setInterval(function() { goTo(current + 1); }, 5000);
      carousel.addEventListener('touchstart', function() { clearInterval(autoTimer); }, { passive: true });
    });
  });
})();
</script>

