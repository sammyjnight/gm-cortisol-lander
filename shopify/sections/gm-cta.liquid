{% comment %}
  Genius Mind — §8b Product CTA + Trustpilot Review Scroller + Featured In
  Dark section with product image, shop CTA, review carousel, and press logos
{% endcomment %}

{%- assign s = section.settings -%}

<section class="sec-dark gm-section" style="padding: 64px 0;" id="gm-cta-{{ section.id }}">
  <div style="max-width: 1136px; margin: 0 auto; padding: 0 16px;">

    <!-- ═══ MOBILE LAYOUT ═══ -->
    <div class="mobile-only" style="text-align: center;">
      <h2 style="font-size: clamp(28px,8vw,40px); font-weight: 900; line-height: 1.05; color: #fff; margin: 0 0 24px;">
        {{ s.heading | default: "Try Genius Mind Risk-Free" }}
      </h2>

      <img
        src="{{ s.product_image | default: 'gm-static-stack-v2.png' | asset_url }}"
        alt="{{ s.product_image_alt | default: 'Genius Mind product stack' }}"
        style="width: 100%; height: auto; margin-bottom: 24px;"
      >

      <a href="{{ s.cta_url | default: '#' }}" class="gm-cta" style="display: block; width: 100%; max-width: 500px; margin: 0 auto; font-size: 18px; font-weight: 800; padding: 18px 32px; border-radius: 12px; text-align: center; text-decoration: none; color: #fff; background: #00A6D2;">
        {{ s.cta_text | default: "SHOP NOW" }} &rarr;
      </a>

      <!-- Trustpilot + Review Scroller -->
      <div style="margin-top: 24px; text-align: left;">
        <div style="margin-bottom: 12px;">
          <div class="tp-eyebrow">
            <span class="tp-eyebrow__label" style="color: #fff; font-weight: 700; font-size: clamp(20px,3vw,28px);">Excellent</span>
            <div class="tp-square-stars" style="display: inline-flex; gap: 3px; margin-left: 10px; vertical-align: middle;">
              <span class="tp-sq-star" style="display:inline-block;width:22px;height:22px;background:#00b67a;position:relative;"><svg viewBox="0 0 24 24" width="16" height="16" style="position:absolute;top:3px;left:3px;fill:#fff;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
              <span class="tp-sq-star" style="display:inline-block;width:22px;height:22px;background:#00b67a;position:relative;"><svg viewBox="0 0 24 24" width="16" height="16" style="position:absolute;top:3px;left:3px;fill:#fff;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
              <span class="tp-sq-star" style="display:inline-block;width:22px;height:22px;background:#00b67a;position:relative;"><svg viewBox="0 0 24 24" width="16" height="16" style="position:absolute;top:3px;left:3px;fill:#fff;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
              <span class="tp-sq-star" style="display:inline-block;width:22px;height:22px;background:#00b67a;position:relative;"><svg viewBox="0 0 24 24" width="16" height="16" style="position:absolute;top:3px;left:3px;fill:#fff;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
              <span class="tp-sq-star tp-sq-star--half" style="display:inline-block;width:22px;height:22px;background:linear-gradient(90deg,#00b67a 50%,#dcdce6 50%);position:relative;"><svg viewBox="0 0 24 24" width="16" height="16" style="position:absolute;top:3px;left:3px;fill:#fff;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg></span>
            </div>
          </div>
          <p class="tp-eyebrow__meta" style="color: rgba(255,255,255,0.6); font-size: 13px; margin-top: 8px;">
            Rated <strong>4.3</strong> / 5 based on <a href="https://uk.trustpilot.com/review/justfloow.com" target="_blank" rel="noopener noreferrer" style="color: rgba(255,255,255,0.6); font-weight: 700; text-decoration: underline; text-underline-offset: 2px;"><strong>141 reviews</strong></a> on
            <span style="font-weight: 900; letter-spacing: -0.02em;">
              <svg viewBox="0 0 24 24" width="16" height="16" style="fill:#00b67a;vertical-align:middle;margin-right:2px;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>Trustpilot
            </span>
          </p>
        </div>

        <!-- Review Carousel -->
        <div class="gm-review-carousel" id="gm-review-carousel-{{ section.id }}">
          <div class="gm-review-track" style="display: flex; overflow: hidden; border-radius: 12px;">
            {% for block in section.blocks %}
              {% if block.type == 'review' %}
                <div class="gm-review-slide" style="flex: 0 0 100%; min-width: 0; padding-right: 8px;" {{ block.shopify_attributes }}>
                  <div style="background: #fff; border-radius: 12px; padding: 20px; text-align: left;">
                    <div style="display: flex; gap: 2px; margin-bottom: 6px;">
                      <svg viewBox="0 0 24 24" width="14" height="14" style="fill:#00b67a;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <svg viewBox="0 0 24 24" width="14" height="14" style="fill:#00b67a;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <svg viewBox="0 0 24 24" width="14" height="14" style="fill:#00b67a;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <svg viewBox="0 0 24 24" width="14" height="14" style="fill:#00b67a;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      <svg viewBox="0 0 24 24" width="14" height="14" style="fill:#00b67a;"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                    </div>
                    <p style="font-weight: 700; font-size: 14px; color: #191919; margin: 0 0 6px;">{{ block.settings.title }}</p>
                    <p style="font-size: 13px; line-height: 1.6; color: rgba(0,0,0,0.6); margin: 0 0 8px;">&ldquo;{{ block.settings.body }}&rdquo;</p>
                    <p style="font-size: 12px; margin: 0;"><strong style="color: #191919;">{{ block.settings.reviewer_name }}</strong> <span style="color: rgba(0,0,0,0.45);">&ndash; Verified Buyer</span></p>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <!-- Dots -->
          <div class="gm-review-dots" style="display: flex; justify-content: center; gap: 6px; margin-top: 12px;">
            {% assign review_index = 0 %}
            {% for block in section.blocks %}
              {% if block.type == 'review' %}
                <button
                  class="gm-review-dot{% if review_index == 0 %} active{% endif %}"
                  data-index="{{ review_index }}"
                  style="width: 8px; height: 8px; border-radius: 50%; border: none; padding: 0; cursor: pointer; transition: all 0.2s; background: {% if review_index == 0 %}#00A6D2{% else %}rgba(255,255,255,0.2){% endif %};"
                  aria-label="Go to review {{ review_index | plus: 1 }}"
                ></button>
                {% assign review_index = review_index | plus: 1 %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>

