        {%- assign tab_labels = "What to Expect|FAQs|Reviews" | split: "|" -%}
        {%- assign tab_ids = "expect|faq|reviews" | split: "|" -%}
        {%- for label in tab_labels -%}
          <button
            class="gm-tab{% if forloop.first %} gm-tab--active{% endif %}"
            data-tab="{{ tab_ids[forloop.index0] }}"
            onclick="gmSwitchTab('{{ tab_ids[forloop.index0] }}')"
            style="padding: 16px 0; text-align: center; font-size: 15px; font-weight: 800; letter-spacing: 0.03em; border: none; cursor: pointer; transition: all 0.2s; {% unless forloop.last %}border-right: 1px solid rgba(255,255,255,0.1);{% endunless %} {% if forloop.first %}background: #3a4255; color: #fff; border-bottom: 3px solid var(--color-cyan);{% else %}background: #252b38; color: rgba(255,255,255,0.5); border-bottom: 3px solid transparent;{% endif %}"
          >
            {{ label }}
          </button>
        {%- endfor -%}
