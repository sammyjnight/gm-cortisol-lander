</section>

<style>
  .gm-tabs-container {
    padding: 16px;
  }
  @media (min-width: 768px) {
    .gm-tabs-container {
      padding: 40px;
    }
    .gm-tab {
      font-size: 18px !important;
      padding: 20px 0 !important;
    }
  }
  .gm-tab:hover:not(.gm-tab--active) {
    color: #fff !important;
    background: #2f3645 !important;
  }
  .gm-expect-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  @media (min-width: 768px) {
    .gm-expect-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

<script>
(function() {
  /* ═══ Tab switching ═══ */
  window.gmSwitchTab = function(tabId) {
    /* Update tab buttons */
    document.querySelectorAll('.gm-tab').forEach(function(btn) {
      var isActive = btn.getAttribute('data-tab') === tabId;
      btn.classList.toggle('gm-tab--active', isActive);
      btn.style.background = isActive ? '#3a4255' : '#252b38';
      btn.style.color = isActive ? '#fff' : 'rgba(255,255,255,0.5)';
      btn.style.borderBottomColor = isActive ? 'var(--color-cyan)' : 'transparent';
    });
    /* Show/hide panels */
    document.querySelectorAll('.gm-tab-panel').forEach(function(panel) {
      panel.style.display = panel.getAttribute('data-panel') === tabId ? 'block' : 'none';
    });
  };

  /* ═══ FAQ accordion ═══ */
  window.gmToggleFaq = function(btn) {
    var item = btn.closest('.gm-faq-item');
    var body = item.querySelector('.gm-faq-body');
    var chevron = item.querySelector('.gm-faq-chevron');
    var isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

    /* Close all others */
    document.querySelectorAll('.gm-faq-item').forEach(function(other) {
      if (other !== item) {
        other.querySelector('.gm-faq-body').style.maxHeight = '0';
        other.querySelector('.gm-faq-chevron').style.transform = 'rotate(0deg)';
      }
    });

    if (isOpen) {
      body.style.maxHeight = '0';
      chevron.style.transform = 'rotate(0deg)';
    } else {
      body.style.maxHeight = '300px';
      chevron.style.transform = 'rotate(180deg)';
    }
  };

  /* ═══ Review accordion ═══ */
  window.gmToggleReview = function(btn) {
    var item = btn.closest('.gm-review-accordion');
    var body = item.querySelector('.gm-rev-body');
    var chevron = item.querySelector('.gm-rev-chevron');
    var isOpen = body.style.maxHeight && body.style.maxHeight !== '0px';

    /* Close all others */
    document.querySelectorAll('.gm-review-accordion').forEach(function(other) {
      if (other !== item) {
        other.querySelector('.gm-rev-body').style.maxHeight = '0';
        other.querySelector('.gm-rev-chevron').style.transform = 'rotate(0deg)';
      }
    });

    if (isOpen) {
      body.style.maxHeight = '0';
      chevron.style.transform = 'rotate(0deg)';
    } else {
      body.style.maxHeight = '300px';
      chevron.style.transform = 'rotate(180deg)';
    }
  };
})();
</script>

