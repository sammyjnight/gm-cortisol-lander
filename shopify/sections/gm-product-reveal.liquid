        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "The 4-6hr decision window high-output work demands. No 2pm cliff."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GM Product Reveal",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "zap",
            "title": "SUSTAINED FOCUS",
            "description": "The 4-6hr decision window high-output work demands. No 2pm cliff."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "brain",
            "title": "MENTAL CLARITY",
            "description": "Brain fog gone. Reading and writing land cleanly first time."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "target",
            "title": "EASIER TO TAKE ACTION",
            "description": "The hard calls stop stalling. Decisions get made."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "waves",
            "title": "REDUCED OVERWHELM",
            "description": "Cognitive load handled. Calm under pressure, not flooded by it."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "battery",
            "title": "STAMINA & RECOVERY",
            "description": "Brain output sustained across the working day. Sleep restores you."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "STRESS RESILIENCE",
            "description": "Cortisol-aware formulation. Built for the operator's chemistry."
          }
        }
      ]
    }
  ]
}
{% endschema %}
