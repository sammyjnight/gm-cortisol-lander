<!-- ═══ 90-DAY GUARANTEE — LIGHT-ALT ═══ -->
<section class="sec-light-alt" style="padding: 56px 0;">
  <div style="max-width: 896px; margin: 0 auto; padding: 0 16px;">
    <div class="fade-up" data-animate>
      <div style="position: relative; overflow: hidden; border-radius: 16px; border: 1px solid rgba(0,0,0,0.06); padding: 32px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1); background: linear-gradient(135deg, #0d1117 0%, #141c28 40%, #1a2436 100%);">

        <!-- Decorative elements -->
        <div style="position: absolute; right: -64px; top: -64px; width: 288px; height: 288px; border-radius: 50%; background: rgba(245,166,35,0.06);"></div>
        <div style="position: absolute; left: -80px; bottom: -80px; width: 224px; height: 224px; border-radius: 50%; background: rgba(0,166,210,0.05);"></div>
        <div style="position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(to right, transparent, rgba(245,166,35,0.3), transparent);"></div>

        <!-- Flex row -->
        <div style="position: relative; display: flex; flex-direction: column; align-items: center; gap: 32px;">

          <!-- Gold guarantee badge -->
          <div style="flex-shrink: 0; width: 150px; height: 150px; border-radius: 50%; border: 3px solid #f5a623; display: flex; align-items: center; justify-content: center; background: linear-gradient(to bottom right, rgba(245,166,35,0.12), rgba(245,166,35,0.03)); box-shadow: 0 0 40px rgba(245,166,35,0.15);">
            <div style="text-align: center; padding: 0 8px;">
              <div style="color: #f5a623; font-size: 30px; margin-bottom: 4px;">&#x1F3C6;</div>
              <div style="font-family: monospace; color: #fff; font-size: 13px; line-height: 1.3; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;">90-Day<br>Money Back</div>
              <div style="color: #f5a623; font-family: monospace; font-size: 10px; margin-top: 4px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.15em;">Guarantee</div>
            </div>
          </div>

          <!-- Text column -->
          <div style="text-align: center;">
            <h2 style="font-size: clamp(24px, 4vw, 36px); font-weight: 900; margin-bottom: 12px; line-height: 1.15; color: #fff;">{{ section.settings.heading_start }} <span style="color: var(--color-cyan);">{{ section.settings.heading_accent }}</span></h2>
            <p style="color: rgba(255,255,255,0.7); font-size: 15px; line-height: 1.7; margin-bottom: 24px;">{{ section.settings.body }}</p>
            <a href="{{ section.settings.cta_url }}" class="btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
              <span>{{ section.settings.cta_text }}</span>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .sec-light-alt { padding: 80px 0 !important; }
    .gm-guarantee-section .fade-up > div > div:last-child {
      flex-direction: row !important;
      gap: 48px !important;
    }
    .gm-guarantee-section .fade-up > div > div:last-child > div:last-child {
      text-align: left !important;
    }
    .gm-guarantee-section .fade-up > div {
      padding: 56px !important;
    }
    .gm-guarantee-section div[style*="width: 150px"] {
      width: 170px !important;
      height: 170px !important;
    }
    .gm-guarantee-section div[style*="width: 150px"] div[style*="font-size: 13px"] {
      font-size: 14px !important;
    }
    .gm-guarantee-section div[style*="width: 150px"] div[style*="font-size: 10px"] {
      font-size: 11px !important;
    }
    .gm-guarantee-section p[style*="font-size: 15px"] {
      font-size: 17px !important;
    }
  }
</style>

{% schema %}
{
  "name": "GM Guarantee",
  "tag": "div",
  "class": "gm-guarantee-section",
  "settings": [
    {
      "type": "text",
      "id": "heading_start",
      "label": "Heading (white part)",
      "default": "Feel a Massive Difference in 90 Days"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading (cyan accent part)",
      "default": "Or Your Money Back"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "We make sure every customer actually gets results or we refund you 100% of your investment. We're so confident you'll feel the difference with Genius Mind that we bear all the risk."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA button text",
      "default": "TRY IT NOW"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button URL",
      "default": "https://justfloow.com/products/genius-mind"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "GM Guarantee"
    }
  ]
}
{% endschema %}
