{{ 'cortisol-lander.css' | asset_url | stylesheet_tag }}
<link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
<style>
  #shopify-section-header, .shopify-section-group-header-group,
  #shopify-section-footer, .shopify-section-group-footer-group,
  .section-header, .shopify-section-header-group { display: none !important; }
  main#MainContent, .main-content { padding: 0 !important; margin: 0 !important; }
</style>

<!-- ═══ BRAND HEADER BAR ═══ -->
<header style="background: #0d1117; padding: 14px 0; text-align: center;">
  <div style="max-width: 1136px; margin: 0 auto; padding: 0 20px;">
    <a href="{{ section.settings.shop_url }}" style="color: #fff; font-weight: 900; font-size: 16px; letter-spacing: 0.2em; text-decoration: none;">GENIUS MIND</a>
  </div>
</header>

<!-- ═══ §01 HERO + §02 SYMPTOMS — UNIFIED DARK CANVAS ═══ -->
<div class="sec-dark">

  <!-- §01 HERO -->
  <div class="sec-pad" style="padding-bottom: 40px;">
    <div class="sec-container">
      <div class="flex flex-col lg:grid grid-mm" style="display: flex; flex-direction: column; align-items: center;">

        <!-- Eyebrow + headline (order 1 on mobile) -->
        <div class="fade-up order-1 col-text-mm" data-animate style="order: 1;">
          <p class="eyebrow-mm" style="margin-bottom: 12px;">
            <span style="color: rgba(255,255,255,0.7);">{{ section.settings.eyebrow_prefix }}</span>
            <span style="color: var(--color-cyan);">{{ section.settings.eyebrow_highlight }}</span>
          </p>
          <h1 class="h1-mm" style="margin-bottom: 4px;">
            <span style="color: #fff;">{{ section.settings.headline }}</span>
            <span style="color: var(--color-cyan);">{{ section.settings.headline_highlight }}</span>
          </h1>

          <!-- Body copy — desktop only -->
          <div class="desktop-only">
            <p style="color: #fff; font-weight: 700; font-size: 22px; line-height: 1.3; margin-bottom: 20px;">{{ section.settings.body_bold }}</p>
            <p style="color: #B0B0B0; font-size: 18px; line-height: 1.5; margin-bottom: 20px;">{{ section.settings.body_para_1 }}</p>
            <p style="color: #B0B0B0; font-size: 18px; line-height: 1.5; margin-bottom: 20px;">{{ section.settings.body_para_2 }}</p>
            <p style="color: var(--color-cyan); font-weight: 700; font-size: 18px; line-height: 1.3;">{{ section.settings.body_cta_line }}</p>
          </div>
        </div>

        <!-- Hero image (order 2 on mobile) -->
        <div class="fade-up order-2 img-bleed" data-animate style="order: 2;">
          <img
            src="{{ section.settings.hero_image | default: 'gm-hero-cortisol-transformation-new.png' | asset_url }}"
            alt="{{ section.settings.hero_image_alt }}"
            width="600"
            height="600"
            loading="eager"
            style="width: 100%; border-radius: 12px; object-fit: cover;"
          >
        </div>

        <!-- Body copy — mobile only (order 3) -->
        <div class="mobile-only order-3" style="order: 3;">
          <p style="color: #fff; font-weight: 700; font-size: 18px; line-height: 1.3; margin-bottom: 16px;">{{ section.settings.body_bold }}</p>
          <p style="color: #B0B0B0; font-size: 16px; line-height: 1.5; margin-bottom: 16px;">{{ section.settings.body_para_1 }}</p>
          <p style="color: #B0B0B0; font-size: 16px; line-height: 1.5; margin-bottom: 16px;">{{ section.settings.body_para_2 }}</p>
          <p style="color: var(--color-cyan); font-weight: 700; font-size: 16px; line-height: 1.3;">{{ section.settings.body_cta_line }}</p>
        </div>

      </div>
    </div>
  </div>

  <!-- §02 SYMPTOMS -->
  <div class="sec-pad" style="padding-top: 0;">
    <div class="sec-container">
      <div class="flex flex-col lg:grid grid-mm" style="display: flex; flex-direction: column; align-items: stretch;">

        <!-- Eyebrow + headline — mobile only (order 1) -->
        <div class="mobile-only" style="order: 1;">
          <p class="eyebrow-mm" style="margin-bottom: 12px; text-align: center; line-height: 1.4;">
            <span style="color: #FFD700;">&#9888;&#65039;</span>
            <span style="color: var(--color-coral);">{{ section.settings.symptoms_eyebrow }}</span>
          </p>
          <h2 class="h2-mm" style="margin-bottom: 16px; color: #fff; text-align: center;">{{ section.settings.symptoms_headline }}</h2>
        </div>

        <!-- Video (mobile order 2, desktop left column) -->
        <div class="fade-up order-2 img-bleed" data-animate style="order: 2; display: flex;">
          <video
            src="{{ section.settings.symptoms_video | default: 'section-2-operator-at-desk.mp4' | asset_url }}"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="{{ section.settings.symptoms_video_alt }}"
            style="width: 100%; border-radius: 12px; object-fit: cover;"
          ></video>
        </div>

        <!-- Copy (mobile order 3, desktop right column) -->
        <div class="fade-up order-3 col-text-mm" data-animate style="order: 3; display: flex; flex-direction: column; justify-content: center;">

          <!-- Desktop-only eyebrow + headline -->
          <div class="desktop-only">
            <p class="eyebrow-mm" style="margin-bottom: 12px; text-align: left; line-height: 1.4;">
              <span style="color: #FFD700;">&#9888;&#65039;</span>
              <span style="color: var(--color-coral);">{{ section.settings.symptoms_eyebrow }}</span>
            </p>
            <h2 class="h2-mm" style="margin-bottom: 24px; color: #fff; text-align: left;">{{ section.settings.symptoms_headline }}</h2>
          </div>

          <p class="body-mm" style="color: #fff; font-weight: 700; margin-bottom: 32px;">{{ section.settings.symptoms_intro }}</p>

          <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 16px;">
            {% for block in section.blocks %}
              {% if block.type == 'symptom' %}
                <div class="warn-box" style="display: flex; align-items: flex-start; gap: 8px;" {{ block.shopify_attributes }}>
                  <span style="font-size: 14px; margin-top: 2px; flex-shrink: 0;">&#9888;&#65039;</span>
                  <p style="line-height: 1.4;">
                    <strong style="color: #fff;">{{ block.settings.bold_text }}</strong>
                    <span style="color: rgba(255,255,255,0.6);">{{ block.settings.rest_text }}</span>
                  </p>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          <p class="body-mm" style="color: rgba(255,255,255,0.8); margin-bottom: 24px;">&#128073; {{ section.settings.symptoms_closing }}</p>
          <p style="color: var(--color-cyan); font-weight: 800; font-size: 16px; line-height: 1.3;">{{ section.settings.symptoms_cta_line }}</p>
        </div>

      </div>
    </div>
  </div>

</div>

{% schema %}
{
  "name": "GM Hero",
  "tag": "section",
  "class": "gm-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "shop_url",
      "label": "Shop URL",
      "default": "https://justfloow.com/products/genius-mind"
    },
    {
      "type": "text",
      "id": "eyebrow_prefix",
      "label": "Eyebrow prefix",
      "default": "16 Ingredients. One Formula."
    },
    {
      "type": "text",
      "id": "eyebrow_highlight",
      "label": "Eyebrow highlight",
      "default": "Zero BS."
    },
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Fix Your Cortisol Brain With This "
    },
    {
      "type": "text",
      "id": "headline_highlight",
      "label": "Headline highlight (cyan)",
      "default": "Natural Upgrade"
    },
    {
      "type": "text",
      "id": "hero_image",
      "label": "Hero image filename",
      "default": "gm-hero-cortisol-transformation-new.png",
      "info": "Filename of image uploaded to Shopify assets"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "High-cortisol brain on the left, Genius Mind product bottle in the centre, low-cortisol brain on the right"
    },
    {
      "type": "text",
      "id": "body_bold",
      "label": "Body bold line",
      "default": "Your brain's not broken – your cortisol's just running the show."
    },
    {
      "type": "textarea",
      "id": "body_para_1",
      "label": "Body paragraph 1",
      "default": "The stress hormone that spikes whenever modern life hits you is the same one depleting the precursors your brain runs on and never letting go."
    },
    {
      "type": "textarea",
      "id": "body_para_2",
      "label": "Body paragraph 2",
      "default": "It's why the focus window keeps shrinking, the second coffee stops working, and the operator in the mirror feels slower than the effort you're putting in."
    },
    {
      "type": "textarea",
      "id": "body_cta_line",
      "label": "Body CTA line",
      "default": "Restore the chemistry. Replenish the precursors. Do that and the brain comes back, while focus skyrockets."
    },
    {
      "type": "text",
      "id": "symptoms_eyebrow",
      "label": "Symptoms eyebrow",
      "default": "The Truth About Cognitive Decline"
    },
    {
      "type": "text",
      "id": "symptoms_headline",
      "label": "Symptoms headline",
      "default": "It's Not Just Burnout"
    },
    {
      "type": "text",
      "id": "symptoms_video",
      "label": "Symptoms video filename",
      "default": "section-2-operator-at-desk.mp4",
      "info": "Filename of video uploaded to Shopify assets"
    },
    {
      "type": "text",
      "id": "symptoms_video_alt",
      "label": "Symptoms video alt text",
      "default": "High-output operator at desk, exhausted late at night"
    },
    {
      "type": "text",
      "id": "symptoms_intro",
      "label": "Symptoms intro text",
      "default": "Many operators 30+ are quietly experiencing..."
    },
    {
      "type": "textarea",
      "id": "symptoms_closing",
      "label": "Symptoms closing text",
      "default": "This isn't aging – this is what chronic cortisol does to the chemistry your brain runs on."
    },
    {
      "type": "textarea",
      "id": "symptoms_cta_line",
      "label": "Symptoms CTA line",
      "default": "Your cortisol controls your chemistry. Fix the chemistry, get the brain back."
    }
  ],
  "blocks": [
    {
      "type": "symptom",
      "name": "Symptom Warning",
      "settings": [
        {
          "type": "text",
          "id": "bold_text",
          "label": "Bold text",
          "default": "Re-reading the same email three times"
        },
        {
          "type": "text",
          "id": "rest_text",
          "label": "Rest of text",
          "default": "before the meaning lands"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GM Hero",
      "blocks": [
        {
          "type": "symptom",
          "settings": {
            "bold_text": "Re-reading the same email three times",
            "rest_text": "before the meaning lands"
          }
        },
        {
          "type": "symptom",
          "settings": {
            "bold_text": "Decision quality dropping by 2pm",
            "rest_text": "— hardest calls always land later"
          }
        },
        {
          "type": "symptom",
          "settings": {
            "bold_text": "The second coffee not doing what it used to",
            "rest_text": "— third gives jitters without focus"
          }
        },
        {
          "type": "symptom",
          "settings": {
            "bold_text": "Word-finding gaps in important conversations",
            "rest_text": "— names, terms, the right word for a Slack message"
          }
        },
        {
          "type": "symptom",
          "settings": {
            "bold_text": "Brain output flatlining",
            "rest_text": "even after sleep, training, and diet are sorted"
          }
        }
      ]
    }
  ]
}
{% endschema %}
