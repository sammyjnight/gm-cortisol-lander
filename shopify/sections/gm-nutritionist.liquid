<!-- ═══ MEET OUR NUTRITIONIST — LIGHT ═══ -->
<section class="sec-light" style="padding: 56px 0;">
  <div style="max-width: 896px; margin: 0 auto; padding: 0 16px; text-align: center;">

    <!-- Heading -->
    <div class="fade-up" data-animate>
      <h2 style="font-size: clamp(32px, 5vw, 52px); font-weight: 900; line-height: 1.05; margin-bottom: 48px; color: var(--color-ink-primary);">{{ section.settings.heading }}</h2>
    </div>

    <div class="fade-up" data-animate>
      <!-- Circular headshot -->
      <div style="display: flex; justify-content: center; margin-bottom: 24px;">
        <div style="width: 180px; height: 180px; border-radius: 50%; overflow: hidden; border: 5px solid rgba(0,166,210,0.15); box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);">
          <img src="{{ section.settings.headshot | asset_url }}" alt="{{ section.settings.name }}" width="220" height="220" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" />
        </div>
      </div>

      <!-- Name -->
      <h3 style="color: var(--color-ink-primary); font-weight: 900; font-size: 28px; margin-bottom: 8px;">{{ section.settings.name }}</h3>

      <!-- Subtitle -->
      <p style="font-family: monospace; color: var(--color-cyan); letter-spacing: 0.15em; text-transform: uppercase; font-size: 13px; font-weight: 700; margin-bottom: 32px;">{{ section.settings.subtitle }}</p>

      <!-- Bio -->
      <p style="color: var(--color-ink-secondary); font-size: 16px; line-height: 1.7; max-width: 640px; margin: 0 auto;">{{ section.settings.bio }}</p>
    </div>
  </div>
</section>

<style>
  @media (min-width: 768px) {
    .sec-light { padding: 80px 0 !important; }
    .sec-light .fade-up div[style*="width: 180px"] {
      width: 220px !important;
      height: 220px !important;
    }
    .sec-light h3[style*="font-size: 28px"] {
      font-size: 36px !important;
    }
    .sec-light p[style*="font-size: 13px"][style*="monospace"] {
      font-size: 14px !important;
    }
    .sec-light p[style*="font-size: 16px"][style*="line-height: 1.7"] {
      font-size: 18px !important;
    }
  }
</style>

{% schema %}
{
  "name": "GM Nutritionist",
  "tag": "div",
  "class": "gm-nutritionist-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet Our Nutritionist"
    },
    {
      "type": "text",
      "id": "headshot",
      "label": "Headshot image filename",
      "default": "shona-wilkinson.png"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name with credentials",
      "default": "Shona Wilkinson, RNutr"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Lead Nutritionist at JustFloow"
    },
    {
      "type": "textarea",
      "id": "bio",
      "label": "Bio paragraph",
      "default": "Shona is a registered nutritionist with over 15 years of experience in clinical nutrition and supplement formulation. She has worked with elite athletes, executives, and health brands to develop evidence-based solutions for cognitive performance."
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "GM Nutritionist"
    }
  ]
}
{% endschema %}
