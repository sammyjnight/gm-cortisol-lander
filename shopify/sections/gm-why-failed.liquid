        {
          "type": "stress_box",
          "settings": {
            "headline": "Stimulant nootropics trigger cortisol.",
            "body": " You feel sharp for an hour. Then the chemistry your brain needs is depleted further."
          }
        }
      ]
    }
  ]
}
{% endschema %}
