<!-- ═══ §6 INGREDIENTS + TRUST BADGES ═══ -->
<section id="formula" class="sec-dark" style="padding: 56px 0;">
  <div style="max-width: 1152px; margin: 0 auto; padding: 0 16px; text-align: center;">

    <!-- Eyebrow + Heading -->
    <div class="fade-up" data-animate>
      <p style="font-family: monospace; color: var(--color-cyan); letter-spacing: 0.25em; text-transform: uppercase; font-size: 13px; font-weight: 600; margin-bottom: 16px;">{{ section.settings.eyebrow }}</p>
      <h2 style="font-size: clamp(32px, 6vw, 56px); font-weight: 900; line-height: 1.0; margin-bottom: 32px; color: #fff;">{{ section.settings.heading }}</h2>
    </div>

    <!-- "No X" row -->
    <div class="fade-up" data-animate style="display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 32px; margin-bottom: 40px;">
      {% assign no_items = section.settings.no_item_1 | append: '||' | append: section.settings.no_item_2 | append: '||' | append: section.settings.no_item_3 | append: '||' | append: section.settings.no_item_4 | append: '||' | append: section.settings.no_item_5 %}
      {% assign no_list = no_items | split: '||' %}
      {% for item in no_list %}
        {% if item != blank %}
          <span style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
            <span style="color: #dc2626; font-size: clamp(24px, 4vw, 32px); font-weight: 900; line-height: 1;">&#10005;</span>
            <span style="color: rgba(255,255,255,0.9); font-size: clamp(13px, 1.5vw, 14px); font-weight: 600; letter-spacing: 0.05em; white-space: pre-line; text-align: center;">{{ item }}</span>
          </span>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Ingredient Cards Grid -->
    <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px;" class="ing-grid">
      {% for block in section.blocks %}
        {% if block.type == 'ingredient' %}
          <div class="fade-up ing-card" data-animate style="background-image: url({{ block.settings.img | asset_url }}); position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 1 / 1; background-size: cover; background-position: center;">
            <!-- Dose pill -->
            <span style="position: absolute; top: 12px; right: 12px; z-index: 2; background: rgba(255,255,255,0.9); color: var(--color-ink-primary); font-family: monospace; font-weight: 600; font-size: 10px; padding: 4px 8px; border-radius: 4px;">{{ block.settings.dose }}</span>
            <!-- Inner content -->
            <div class="ing-inner" style="position: absolute; bottom: 0; left: 0; right: 0; padding: 16px; z-index: 2; display: flex; flex-direction: column; justify-content: flex-end; background: linear-gradient(to top, rgba(0,0,0,0.7) 0%, transparent 100%);">
              <h4 style="color: #fff; font-weight: 900; font-size: clamp(16px, 2vw, 20px); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 2px;">{{ block.settings.name }}</h4>
              <p style="color: rgba(255,255,255,0.85); font-size: clamp(12px, 1.2vw, 13px); line-height: 1.4; font-weight: 500; margin: 0;">{{ block.settings.desc }}</p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- Trust Badges -->
<div style="background: var(--color-dark-primary); padding: 40px 0;">
  <div style="max-width: 1024px; margin: 0 auto; padding: 0 16px; display: flex; flex-wrap: wrap; justify-content: center; gap: 24px 40px; text-align: center;">
    {% for block in section.blocks %}
      {% if block.type == 'trust_badge' %}
        <div class="fade-up" data-animate style="display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 80px;">
          <span style="color: #fff; opacity: 0.8; font-size: 28px;">{{ block.settings.icon }}</span>
          <p style="font-family: monospace; font-size: clamp(10px, 1.2vw, 11px); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #fff; white-space: pre-line; line-height: 1.3; margin: 0;">{{ block.settings.label }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

<style>
  @media (min-width: 768px) {
    .ing-grid { grid-template-columns: repeat(4, 1fr) !important; }
    section#formula { padding: 80px 0 !important; }
  }
  @media (min-width: 768px) {
    .fade-up[data-animate] .ing-grid { gap: 12px; }
  }
</style>

